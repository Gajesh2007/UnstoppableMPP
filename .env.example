# BIP-39 mnemonic — derives both the wallet and encryption keypair
# Generate with: bun -e "import { generateMnemonic } from '@scure/bip39'; import { wordlist } from '@scure/bip39/wordlists/english'; console.log(generateMnemonic(wordlist))"
MNEMONIC=

# MPP secret key for HMAC-bound challenge IDs (required)
# Generate with: openssl rand -hex 32
MPP_SECRET_KEY=

# Server
PORT=3000

# Platform fee percentage (default 5%)
PLATFORM_FEE_PCT=5

# Database path
DATABASE_PATH=./data/unstoppable.db

# USDC token address on Tempo (default: mainnet USDC)
TEMPO_USDC_ADDRESS=0x20c000000000000000000000b9537d11c60e8b50

# OpenAI pricing refresh interval in minutes (default 60)
PRICING_REFRESH_INTERVAL_MIN=60
